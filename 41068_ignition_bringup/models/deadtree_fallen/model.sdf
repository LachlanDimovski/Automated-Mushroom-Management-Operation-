<?xml version="1.0" ?>
<sdf version="1.8">
    <model name="deadtree_fallen">
        <static>true</static>
        <link name="link">
            <!-- ponytail: box collision is a rough fit to this scanned mesh's
                 footprint (it wasn't authored as a clean trunk primitive like the
                 other trees) - tighten radius/length here if it looks off in sim. -->
            <collision name="trunk">
                <pose>0 0 0.6 0 0 0</pose>
                <geometry><box><size>7.0 2.2 1.2</size></box></geometry>
            </collision>
            <visual name="visual">
                <geometry><mesh><uri>meshes/scene.obj</uri><scale>0.01 0.01 0.01</scale></mesh></geometry>
            </visual>
        </link>
    </model>
</sdf>
