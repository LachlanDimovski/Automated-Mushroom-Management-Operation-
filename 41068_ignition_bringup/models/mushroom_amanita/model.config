<?xml version="1.0"?>
<model>
  <name>Amanita Mushroom</name>
  <version>1.0</version>
  <sdf version='1.6'>model.sdf</sdf>

  <author>
    <name>Henry Salter</name>
    <email>hpdsalter@gmail.com</email>
  </author>

  <description>
    A red Amanita muscaria (fly agaric) mushroom, used as the detection target
    for the custom YOLO11n model in skidsteer_perception. Mesh sourced
    externally - see README_MUSHROOM.md for import steps and attribution.
  </description>
</model>
