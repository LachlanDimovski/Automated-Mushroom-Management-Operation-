<?xml version="1.0"?>
<sdf version="1.8">
  <model name="tree_pine">
    <static>true</static>
    <link name="link">
      <collision name="trunk">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.22</radius><length>7.0</length></cylinder>
        </geometry>
      </collision>
      <visual name="branch">
        <geometry>
          <mesh>
            <uri>model://tree_pine/meshes/pine_tree.dae</uri>
            <submesh><name>Branch</name></submesh>
          </mesh>
        </geometry>
        <material>
          <double_sided>true</double_sided>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tree_pine/materials/textures/branch_2_diffuse.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="bark">
        <geometry>
          <mesh>
            <uri>model://tree_pine/meshes/pine_tree.dae</uri>
            <submesh><name>Bark</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://tree_pine/materials/textures/bark_diffuse.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
