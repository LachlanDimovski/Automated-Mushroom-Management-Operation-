<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
  <!-- Properties -->
  <xacro:property name="wheel_separation" value="0.5708"/>
  <xacro:property name="wheel_radius" value="0.1651"/>

  <xacro:macro name="wheel" params="prefix wheel_id x_pos y_pos side">
    <link name="${prefix}${wheel_id}_wheel_link">
      <xacro:if value="$(arg x2_body)">
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <mesh filename="file://$(find 41068_ignition_bringup)/urdf_husky/meshes/x2/x2_wheel_${side}.dae" scale="1.7 1.7 1.7"/>
          </geometry>
        </visual>
      </xacro:if>
      <xacro:unless value="$(arg x2_body)">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file://$(find 41068_ignition_bringup)/urdf_husky/meshes/wheel.dae"/>
          </geometry>
        </visual>
      </xacro:unless>

      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/> 
        <contact_coefficients mu="0.5" kp="1+e07" kd="1"/> 
        <geometry>
          <cylinder length="0.1143" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.637"/>
        <inertia ixx="0.02467" ixy="0" ixz="0"
                iyy="0.04411" iyz="0"
                izz="0.02467" />
      </inertial>
    </link>

    <!-- Low lateral friction so the skid-steer can pivot in place. The URDF
         contact_coefficients above are dropped in the SDF conversion, leaving
         Gazebo's default mu=1: four wheels then refuse to skid and the rover
         had a ~0.5 rad/s turn dead-band. X2 (the visual body) ships mu=0.1. -->
    <gazebo reference="${prefix}${wheel_id}_wheel_link">
      <mu1>0.3</mu1>
      <mu2>0.1</mu2>
    </gazebo>

    <!-- Add joint to main body -->
    <joint name="${prefix}${wheel_id}_wheel_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${wheel_id}_wheel_link" />
      <origin xyz="${x_pos} ${y_pos} 0.03282" rpy="0 0 0"/>
      <limit lower="-1e+16" upper="1e+16" effort="1e+16" velocity="1e+16"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.004"/>
    </joint>

  </xacro:macro>
</robot>
