<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_lo</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="udp_lo" is_default_profile="true">
        <rtps>
            <builtin>
                <discovery_config>
                    <leaseDuration><sec>3600</sec></leaseDuration>
                </discovery_config>
            </builtin>
            <userTransports><transport_id>udp_lo</transport_id></userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
    <data_writer profile_name="no_data_sharing_w" is_default_profile="true">
        <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
    </data_writer>
    <data_reader profile_name="no_data_sharing_r" is_default_profile="true">
        <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
    </data_reader>
</profiles>
