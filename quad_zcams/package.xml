<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_zcams</name>
  <version>0.0.1</version>
  <description>Parrot with a down and an up depth camera: height above whatever is below, and climbs
  over canopies only into clear sky. Trial alongside the stock quad; launch with zcam_mission.launch.py.</description>
  <maintainer email="lachlan.dimovski02@gmail.com">Lachlan Dimovski</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ammo_mission_control</exec_depend>
  <exec_depend>41068_ignition_bringup</exec_depend>
  <exec_depend>ros_ign_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
