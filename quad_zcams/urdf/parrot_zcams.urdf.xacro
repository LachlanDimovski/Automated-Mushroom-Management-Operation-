<?xml version="1.0"?>
<!-- The standard Parrot plus a down and an up depth camera: height above whatever is below, and headroom. -->
<robot name="parrot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find 41068_ignition_bringup)/urdf_parrot/parrot.urdf.xacro"/>

  <!-- pitch +pi/2 points the camera's +x (view axis) straight down, -pi/2 straight up -->
  <xacro:macro name="zcam" params="name z pitch">
    <joint name="${prefix}${name}_joint" type="fixed">
      <origin xyz="0 0 ${z}" rpy="0 ${pitch} 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_link"/>
    </joint>
    <link name="${prefix}${name}_link">
      <visual>
        <geometry><box size="0.03 0.05 0.03"/></geometry>
        <material name="dark"/>
      </visual>
    </link>
    <gazebo reference="${prefix}${name}_link">
      <sensor name="${name}" type="depth_camera">
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>96</width>
            <height>96</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>25</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/model/${gz_model_name}/${name}</topic>
        <gz_frame_id>${prefix}${name}_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- below the hull, and above the lidar puck (top at 0.22 m) -->
  <xacro:zcam name="down_depth" z="-0.12" pitch="${pi/2}"/>
  <xacro:zcam name="up_depth" z="0.26" pitch="${-pi/2}"/>
</robot>
